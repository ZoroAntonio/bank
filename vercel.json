{
  "routes": [
    {
      "src": "/.*",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive, nosnippet, noimageindex",
        "Cache-Control": "no-store, no-cache, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/.*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|TelegramBot).*"
        }
      ],
      "status": 204
    },
    { "handle": "filesystem" },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
